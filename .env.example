# Copy to .env and fill real values. NEVER commit the real .env file.

# --- Free AIS stream (existing + Sentinel connector) ---
AISSTREAM_API_KEY=YOUR_AISSTREAM_API_KEY_HERE
# Optional overrides for services/aisstream_connector.py (defaults in config.yaml):
# SENTINEL_SUBSCRIPTION_MODE=single_persistent
# SENTINEL_MMSI_PER_SUBSCRIPTION=200
# SENTINEL_ROTATION_INTERVAL_SECONDS=180
# SENTINEL_COVERAGE_WINDOW_SECONDS=540
# SENTINEL_TRY_FULL_MMSI=0

# --- Docker / Sentinel runtime (container-relative paths only) ---
# Canonical dashboard port (Docker + local release). Override via env if needed.
PORT=8765
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8765
APP_HOME=/app
ASSETS_7000_DIR=/app/assets/7000
SENTINEL_DB_PATH=/app/история1/sentinel_ais.db
OUTPUT_DIR=/app/output
DATA_DIR=/app/data
TTF_ROLLUP_INTERVAL_SEC=21600
TTF_ROLLUP_INITIAL_DELAY_SEC=90

# --- Optional PostgreSQL / TimescaleDB dual-store for Sentinel ---
# Leave empty to use SQLite only (/app/история1/sentinel_ais.db in Docker).
# Example after `docker compose up -d timescaledb`:
# DATABASE_URL=postgresql://oracle:oracle1001@timescaledb:5432/sentinel_ais

# --- Paid weekly gas-carrier monitor (VesselFinder credit API by default) ---
# Get a key at https://api.vesselfinder.com/ — do not put real secrets here.
PROVIDER_NAME=vesselfinder
PROVIDER_BASE_URL=https://api.vesselfinder.com/vessels
PROVIDER_API_KEY=YOUR_PROVIDER_API_KEY_HERE
# USD charged (or equivalent) per single vessel lookup — used for the $50/mo budget gate.
# Example: if 1 credit ≈ $0.033, set 0.033. Must match your real tariff.
PROVIDER_COST_PER_CALL_USD=0.05
PROVIDER_MONTHLY_BUDGET_USD=50

# --- VesselFinder Fleet Positions (archive rotation · Premium/Satellite plan) ---
# Used by: python -m services.archive_service --force-sync
# Cascade also reads: VESSEL_FINDER_USERKEY, VESSEL_FINDER_KEY, COMMERCIAL_USERKEY, API_KEY
# Prefer commercial REST userkey when available; otherwise hybrid_local fallback.
# NEVER commit the real key. Fleet slot cap is plan-limited (typically 500).
VESSEL_FINDER_USERKEY=YOUR_VESSELFINDER_COMMERCIAL_USERKEY_HERE
VESSELFINDER_API_KEY=YOUR_VESSELFINDER_FLEET_API_KEY_HERE
VESSEL_FINDER_PLAN=commercial_rest
VESSELFINDER_FLEET_SLOT_LIMIT=500
VESSELFINDER_ROTATION_CYCLE_DAYS=3
# Tiered ingest: hours 0-1 = gas (tier1), hour 2 = oil (tier2). Advance every N hours.
ARCHIVE_SLOT_INTERVAL_HOURS=1
# Balance engine default lookback (hours). 168 = 7 days out-of-box.
BALANCE_LOOKBACK_HOURS=168
# Optional Tier-2 oil tanker registry (~4655). If missing, oil slot falls back to gas.
# FLEET_OIL_CSV=C:/path/to/fleet_oil_tankers.csv
# Optional: protect POST /api/config/update-key (localhost still required)
# SENTINEL_ADMIN_TOKEN=

# --- Optional LLM structured extract (Instructor → VesselProfile20Cols) ---
# Local schema path is default (free). Set USE_LLM_EXTRACT=1 to call OpenAI.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# USE_LLM_EXTRACT=0
