[Unit]
Description=Oracle-1001 daily AIS snapshot + forecast stub
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/oracle1001/ais_archive
EnvironmentFile=-/opt/oracle1001/ais_archive/.env
ExecStart=/opt/oracle1001/ais_archive/venv/bin/python daily_snapshot.py
# forecast.py is optional; ignore failure if archive still shallow
ExecStartPost=-/opt/oracle1001/ais_archive/venv/bin/python forecast.py
Nice=10
MemoryMax=500M
