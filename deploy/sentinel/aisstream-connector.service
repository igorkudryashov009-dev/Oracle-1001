[Unit]
Description=Oracle-1001 Sentinel AISStream Live Connector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/oracle1001/analytical_engine
EnvironmentFile=-/opt/oracle1001/analytical_engine/.env
ExecStart=/opt/oracle1001/analytical_engine/venv/bin/python -m services.aisstream_connector
Restart=always
RestartSec=5s
StandardOutput=append:/var/log/oracle1001/aisstream_connector.log
StandardError=append:/var/log/oracle1001/aisstream_connector.err

[Install]
WantedBy=multi-user.target
